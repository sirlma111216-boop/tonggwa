# 브라우저 번들에 포함되는 공개 설정만 VITE_ 접두어로 둔다. 비밀키를 넣지 않는다.
VITE_APP_ENV=development

# Firebase (아직 연결 전). 연결 시 Firebase 콘솔의 웹앱 설정값을 넣는다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=asia-northeast3

# Gemini API 키는 여기(VITE_)에 넣지 않는다. Cloudflare Worker secret(GEMINI_API_KEY)으로만 둔다.
#   npx wrangler secret put GEMINI_API_KEY
