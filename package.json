{
  "name": "tonggwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "고등학교 1학년 통합과학 학생용 학습 웹앱 (V1)",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:pilot": "npm run content && node scripts/check-pilot-content.mjs && node --test scripts/test-pilot.mjs",
    "test:concept": "npm run content && node --test scripts/test-concept-journey.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright-core": "^1.58.2",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "wrangler": "^4.151.0"
  }
}
